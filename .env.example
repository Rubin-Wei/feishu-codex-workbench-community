# Copy to .env; chmod 600 .env. Never commit credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Alternative on macOS: read only this app's existing lark-cli encrypted credential.
FEISHU_LARK_PROFILE=
# Optional: app-specific open_id. Otherwise use the one-time pairing command.
FEISHU_OWNER_OPEN_ID=
WORKBENCH_CONFIG=config.local.toml

# Independent web workbench (runtime secrets, never commit actual values)
WORKBENCH_SITE_URL=
# Current Feishu/Miaoda transport: scoped OpenAPI key, Authorization: Bearer.
WORKBENCH_AGENT_URL=
WORKBENCH_OPENAPI_KEY=
# Optional legacy Sites transport only
WORKBENCH_AGENT_SECRET=
WORKBENCH_SITE_ACCESS_TOKEN=
WORKBENCH_SSH_CONFIG=
WORKBENCH_CONTROLLER_LABEL=Controller
